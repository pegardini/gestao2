---
import Base from '../layouts/Base.astro';
import BookDetail from '../components/BookDetail.astro';
import { getBook } from '../data/site';
import { bookSchema } from '../lib/bookSchema';

const book = getBook('jesus-tora')!;
---

<Base
  title={book.title}
  description={`${book.title} — ${book.subtitle}. Ebook Kindle por R$ 17,73 na Amazon.`}
  schema={bookSchema(book)}
>
  <BookDetail book={book} />
</Base>
