---
interface Props {
  name:
    | 'arrow'
    | 'arrow-down'
    | 'external'
    | 'mail'
    | 'instagram'
    | 'youtube'
    | 'linkedin'
    | 'facebook'
    | 'printer'
    | 'quote';
  class?: string;
}

const { name, class: className = '' } = Astro.props;

const paths: Record<string, string> = {
  arrow: '<path d="M4 12h15M13 6l6 6-6 6" />',
  'arrow-down': '<path d="M12 4v15M6 13l6 6 6-6" />',
  external:
    '<path d="M14 4h6v6M20 4l-9 9" /><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />',
  mail: '<rect x="3" y="5" width="18" height="14" rx="1.5" /><path d="m3.5 6.5 8.5 6 8.5-6" />',
  instagram:
    '<rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none" />',
  youtube:
    '<rect x="2.5" y="5.5" width="19" height="13" rx="4" /><path d="m10.5 9.5 5 2.5-5 2.5z" fill="currentColor" stroke="none" />',
  linkedin:
    '<rect x="3" y="3" width="18" height="18" rx="2.5" /><path d="M7.5 10v7M7.5 7.2v.1M11.5 17v-7M11.5 13.2c0-1.8 1-3 2.6-3 1.7 0 2.4 1.1 2.4 3V17" />',
  facebook:
    '<path d="M15.5 8.5h-2.2c-.9 0-1.3.5-1.3 1.4v1.6h3.4l-.5 3h-2.9V21H9v-6.5H6.5v-3H9V9.7C9 7.2 10.4 6 12.7 6h2.8z" />',
  quote:
    '<path d="M9.5 6.5c-2.8 1-4.5 3.4-4.5 6.6V18h6v-6H7.4c0-2 .8-3.3 2.7-4.1zM20 6.5c-2.8 1-4.5 3.4-4.5 6.6V18h6v-6h-3.6c0-2 .8-3.3 2.7-4.1z" />',
  printer:
    '<path d="M7 9V4h10v5" /><rect x="4" y="9" width="16" height="7" rx="1.5" /><path d="M7 14h10v6H7z" />',
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
