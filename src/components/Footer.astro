---
import Icon from './Icon.astro';
import { site } from '../data/site';

const year = new Date().getFullYear();
const socials = site.socials;
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-top">
      <div class="footer-brand">
        <a class="brand" href="/" aria-label="Página inicial">
          <svg class="brand__mark" viewBox="0 0 48 60" fill="none" aria-hidden="true">
            <path d="M8 56V25C8 12 15.5 5.5 24 3c8.5 2.5 16 9 16 22v31" stroke="currentColor" stroke-width="1.1" />
            <path d="M13 56V26c0-9.5 5-14.5 11-16.6C30 11.5 35 16.5 35 26v30" stroke="currentColor" stroke-width="0.6" opacity="0.55" />
            <path d="M24 3V0M21.5 1.5h5" stroke="currentColor" stroke-width="0.9" />
            <text x="24" y="42" text-anchor="middle" font-family="Newsreader Variable, Georgia, serif" font-size="15" fill="currentColor" letter-spacing="0.5">PG</text>
          </svg>
          <span class="brand__text">
            <span class="brand__name">Pe. Pedro de Celso Gardini</span>
            <span class="brand__role">Sacerdote · Jornalista · Autor</span>
          </span>
        </a>
        <p class="footer-tagline">Livros para servir, organizar e acolher.</p>
      </div>

      <nav class="footer-links" aria-label="Links do rodapé">
        <a href="/sobre">Sobre</a>
        <a href="/#livros">Livros</a>
        <a href="/ferramentas">Ferramentas</a>
        <a href="/recursos">Recursos</a>
        <a href="/contato">Contato</a>
        <a href="/privacidade">Privacidade</a>
        {socials.map((social) => <a href={social.url} target="_blank" rel="noopener noreferrer">{social.label}</a>)}
      </nav>
    </div>

    <div class="footer-bottom">
      <p class="catalog-card">
        GARDINI, Pedro de Celso. <em>Livros para servir, organizar e acolher</em>: gestão pastoral, acolhida e raízes judaicas. São Carlos, {year}.
      </p>
      <p>© {year} Pe. Pedro de Celso Gardini. Todos os direitos reservados.</p>
    </div>
  </div>
</footer>
